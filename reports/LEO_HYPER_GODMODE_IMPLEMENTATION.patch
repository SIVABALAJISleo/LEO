+        inputs.data_ptr<float>(),
+        W_packed.data_ptr<float>(),
+        indices.data_ptr<uint8_t>(),
+        outputs.data_ptr<float>(),
+        batch_size,
+        in_features,
+        out_features
+    );
+
+    return outputs;
+}
