+            self.scoreboard_2.status == ScoreboardStatus.PASS and
+            self.scoreboard_3.status == ScoreboardStatus.PASS and
+            self.scoreboard_4.status == ScoreboardStatus.PASS and
+            self.scoreboard_5.status == ScoreboardStatus.PASS
