{
    "include": [
        "backend",
        "orchestration",
        "chaos",
        "experts",
        "engine_hv",
        "predictors",
        "rag",
        "router",
        "routers",
        "adapters",
        "approximation",
        "retrieval",
        "intelligence",
        "memory",
        "predictive"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "src",
        "dist",
        "venv",
        ".git"
    ],
    "venvPath": ".",
    "venv": "venv",
    "pythonVersion": "3.11",
    "pythonPlatform": "Windows",
    "typeCheckingMode": "basic",
    "reportMissingImports": "none",
    "extraPaths": [
        ".",
        "./orchestration",
        "./approximation",
        "./backend"
    ],
    "executionEnvironments": [
        {
            "root": "."
        }
    ]
}
