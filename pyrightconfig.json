{
    "include": [
        "."
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "dist",
        "venv",
        ".git"
    ],
    "venvPath": ".",
    "venv": "venv",
    "pythonVersion": "3.11",
    "pythonPlatform": "Windows",
    "typeCheckingMode": "basic",
    "reportMissingImports": "none",
    "stubPath": ".",
    "extraPaths": [
        "."
    ],
    "executionEnvironments": [
        {
            "root": "orchestration",
            "extraPaths": [".."]
        },
        {
            "root": ".",
            "extraPaths": ["."]
        }
    ]
}
