rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: only the authenticated user can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Usernames collection: restricted to authenticated users only (Convergence 8)
    // Previously: allow read: if true; — This exposed all usernames publicly (SECURITY RISK)
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Workspaces collection: tenant isolation
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null
        && resource.data.tenant_id == request.auth.token.tenant_id;
    }
  }
}
