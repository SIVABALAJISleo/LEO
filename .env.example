# ── Copy this to .env and fill in your values ─────────────────────────────────
# NEVER commit .env to git

APP_ENV=development                         # development | staging | production

SECRET_KEY=replace-with-a-random-64-char-string   # used for local JWT signing
                                                   # generate: python -c "import secrets; print(secrets.token_hex(32))"

FIREBASE_CREDENTIALS=                       # leave empty to use local JWT
                                            # or set path: ./firebase-service-account.json

ALLOWED_ORIGINS=http://localhost:5173       # comma-separated for multiple origins
                                            # production: https://yourdomain.com

# ── SaaS Integrations ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...               # Stripe API Secret for Billing
STRIPE_WEBHOOK_SECRET=whsec_...             # Stripe Webhook verification secret
VITE_STRIPE_PUBLIC_KEY=pk_test_...          # Stripe Frontend Public Key

SENTRY_DSN=https://...                      # Centralized Error Tracking APM

# ── PayPal Integrations ────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=...                         # PayPal Client ID
PAYPAL_CLIENT_SECRET=...                     # PayPal Client Secret
PAYPAL_WEBHOOK_ID=...                        # PayPal Webhook ID (from dashboard)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com # Change to production for live
