# ── Copy this to .env and fill in your values ─────────────────────────────────
# NEVER commit .env to git

APP_ENV=development                         # development | staging | production

SECRET_KEY=replace-with-a-random-64-char-string   # used for local JWT signing
                                                   # generate: python -c "import secrets; print(secrets.token_hex(32))"

FIREBASE_CREDENTIALS=                       # leave empty to use local JWT
                                            # or set path: ./firebase-service-account.json

ALLOWED_ORIGINS=http://localhost:5173       # comma-separated for multiple origins
                                            # production: https://yourdomain.com
