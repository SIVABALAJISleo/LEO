# LEO AI Frontend — Environment Variables
# Copy this file to `.env` for local dev, or set these in your host's dashboard for production.

# --- REQUIRED ---
# Base URL of your Python LEO backend (OpenAI-compatible + /api/v1/leo/* endpoints).
# Local dev default:
VITE_LEO_API_BASE_URL=http://localhost:8005
# Production example:
# VITE_LEO_API_BASE_URL=https://api.your-domain.com

# --- OPTIONAL ---
# Node runtime (only needed if you self-host the SSR server).
# NODE_ENV=production
# PORT=3000
